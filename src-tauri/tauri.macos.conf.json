{
  "productName": "June",
  "build": {
    "runner": "../scripts/cargo-clovy-runner.sh",
    "beforeBundleCommand": "bash scripts/bundle-nm-shim.sh"
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": {
      "resources/macos/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "../.tauri-helper/June.app": "native/bin/June.app",
      "../.tauri-helper/June Dictation Helper.app": "native/bin/June Dictation Helper.app",
      "../.tauri-helper/clovy-nm-shim": "native/bin/clovy-nm-shim",
      "../.tauri-helper/june-nm-shim": "native/bin/june-nm-shim",
      "../.tauri-helper/June Computer Use Driver.app": "native/bin/June Computer Use Driver.app",
      "../.tauri-agent-runtime/clovy-agent-runtime": "native/bin/clovy-agent-runtime",
      "../.tauri-agent-runtime/clovy-agent-runtime.sha256": "native/bin/clovy-agent-runtime.sha256",
      "../extension/dist": "native/extension",
      "resources/agent-skills": "native/agent-skills"
    },
    "macOS": {
      "bundleName": "Clovy",
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.0"
    }
  }
}
